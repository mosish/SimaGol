NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
ORDERS_ENABLED=false

# Optional exact socket IP of a reverse proxy that overwrites X-Real-IP.
TRUST_PROXY_ADDRESS=

# Set after generating data/vapid-private.pem. Use a monitored mailto: contact.
VAPID_SUBJECT=

# Optional Kavenegar verified templates. Reminder token = number of days before the occasion.
KAVENEGAR_API_KEY=
SMS_OTP_TEMPLATE=
SMS_REMINDER_TEMPLATE=

# Public origin must match each registered OAuth callback URL.
# /api/identity/google/callback and /api/identity/apple/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Apple Services ID client secret (signed JWT); rotate before expiry.
APPLE_CLIENT_SECRET=
# Optional password recovery email
RESEND_API_KEY=
AUTH_EMAIL_FROM=
